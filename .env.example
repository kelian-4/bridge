# Copier vers .env (ignoré par git), ou lancer Docker/setup.sh qui le crée.
# Ne jamais committer le vrai .env.

# --- À renseigner avant setup.sh ---
SERVER_NAME=local.bridge
ADMIN_MXID=@CHANGE_ME:local.bridge

# --- Générés automatiquement par Docker/setup.sh (laisser vides) ---
POSTGRES_PASSWORD=
REGISTRATION_SHARED_SECRET=
MACAROON_SECRET_KEY=
FORM_SECRET=
SIGNAL_AS_TOKEN=
SIGNAL_HS_TOKEN=
WHATSAPP_AS_TOKEN=
WHATSAPP_HS_TOKEN=

# --- À remplir après le premier démarrage (tokens Matrix) ---
MATRIX_ACCESS_TOKEN=CHANGE_ME
INVITER_ACCESS_TOKEN=CHANGE_ME
SIGNAL_RELAY_LOGIN_ID=00000000-0000-0000-0000-000000000000
PG_DSN=postgresql://bridgeadmin:CHANGE_ME@127.0.0.1:5432/synapse

# --- Optionnels (valeurs par défaut dans les scripts) ---
MATRIX_HOMESERVER_URL=http://127.0.0.1:8008
MATRIX_USER_ID=@user:local.bridge
INVITER_USER_ID=@inviter:local.bridge
WHATSAPP_BOT_MXID=@whatsappbot:local.bridge
SIGNAL_BOT_MXID=@signalbot:local.bridge
TELEGRAM_BOT_MXID=@telegrambot:local.bridge
BOT_RESPONSE_TIMEOUT=30
ROOM_PROCESSING_DELAY=2
CONFIRM_DELAY=2
MUTE_LEVEL=
ROOM_LIST_FILE=rooms.txt
SYNC_TOKEN_FILE=.sync_token
LOG_LEVEL=INFO

# --- Images Docker (optionnel : à définir seulement pour utiliser un autre registre ou miroir) ---
# SIGNAL_IMAGE=dock.mau.dev/mautrix/signal:latest
# WHATSAPP_IMAGE=dock.mau.dev/mautrix/whatsapp:latest
# SYNAPSE_IMAGE=matrixdotorg/synapse:latest
# POSTGRES_IMAGE=postgres:16-alpine
