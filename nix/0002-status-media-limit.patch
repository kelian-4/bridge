diff --git a/pkg/connector/handlewhatsapp.go b/pkg/connector/handlewhatsapp.go
index 3abcede..3934536 100644
--- a/pkg/connector/handlewhatsapp.go
+++ b/pkg/connector/handlewhatsapp.go
@@ -312,6 +312,16 @@ func (wa *WhatsAppClient) handleWAMessage(ctx context.Context, evt *events.Messa
 	if evt.Info.Chat == types.StatusBroadcastJID && !wa.Main.Config.EnableStatusBroadcast {
 		return
 	}
+	if evt.Info.Chat == types.StatusBroadcastJID && wa.Main.Config.StatusBroadcastMaxMediaMB > 0 {
+		limit := uint64(wa.Main.Config.StatusBroadcastMaxMediaMB) * 1024 * 1024
+		if size := statusMediaLength(evt.Message); size > limit {
+			wa.UserLogin.Log.Info().
+				Str("message_id", evt.Info.ID).
+				Uint64("size", size).
+				Msg("Skipping oversized status media")
+			return
+		}
+	}
 	parsedMessageType := getMessageType(evt.Message)
 	if encReact := evt.Message.GetEncReactionMessage(); encReact != nil {
 		decrypted, err := wa.Client.DecryptReaction(ctx, evt)
@@ -914,3 +924,19 @@ func (wa *WhatsAppClient) handleWAAppStateSyncError(ctx context.Context, evt *ev
 		}
 	}()
 }
+
+func statusMediaLength(msg *waE2E.Message) uint64 {
+	switch {
+	case msg.GetImageMessage() != nil:
+		return msg.GetImageMessage().GetFileLength()
+	case msg.GetVideoMessage() != nil:
+		return msg.GetVideoMessage().GetFileLength()
+	case msg.GetAudioMessage() != nil:
+		return msg.GetAudioMessage().GetFileLength()
+	case msg.GetDocumentMessage() != nil:
+		return msg.GetDocumentMessage().GetFileLength()
+	case msg.GetStickerMessage() != nil:
+		return msg.GetStickerMessage().GetFileLength()
+	}
+	return 0
+}
